* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  

}

header {
  background-color:rgb(35,45,25);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
  font-family: "DynaPuff", system-ui;
}

/* LOGO VERMONT */
.logo-img {
  display: flex;
  align-items: center;
  width: 30px;
  height: 12px;
  color: #ffffff;
  
}

/* NAVIGASI */
nav {
  display: flex;
  gap: 40px;
}

nav a {
  color: #ffffff;
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
}

nav a:hover {
  color: #78ac6b;
}

/* RESERVASI*/
.btn-reserve {
  background-color: #ffffff;
  color: #1a2e1a;
  border: none;
  padding: 10px 20px;
  font-size: 15px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
}

.btn-reserve:hover {
  background-color: #a8c5a0;
  color: #1a2e1a;
}

/* ===== HERO ===== */
.hero {
  position: relative;
  width: 100%;
  height: 80vh;
  background-image: url('P1.png'); 
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Gelap overlay di atas foto */
.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.45);
}

/* Teks di tengah */
.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #ffffff;
  animation: fadeUp 1.2s ease-out both;
}

.hero-content h1 {
  font-family: 'Playfair Display', serif;
  font-size: 64px;
  font-weight: 400;
  margin-bottom: 16px;
  letter-spacing: 1px;
}

.hero-content h2 {
  font-family: 'Raleway', sans-serif;
  font-size: 14px;
  font-weight: 300;
  letter-spacing: 4px;
  color: #e0e0e0;
}

/* ===== ANIMASI ===== */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== MENU SECTION ===== */
.menu-section {
  padding: 80px 60px;
  background-color: #ffffff;
  margin-top: 60px;
}

.menu-header {
  text-align: center;
  margin-bottom: 40px;
}

.menu-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  font-weight: 400;
  color: #1a2e1a;
  margin-bottom: 12px;
}

.menu-header p {
  font-family: 'Raleway', sans-serif;
  font-size: 15px;
  font-weight: 300;
  letter-spacing: 3px;
  color: #777;
}

/* ===== TOMBOL KATEGORI ===== */
.menu-categories {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 50px;
  flex-wrap: wrap;
}

.cat-btn {
  font-family: 'Raleway', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 10px 28px;
  border: 1.5px solid #1a2e1a;
  background-color: transparent;
  color: #1a2e1a;
  border-radius: 30px;
  cursor: pointer;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.cat-btn:hover {
  background-color:rgb(35,45,25);
  color: #ffffff;
}

.cat-btn.active {
  background-color: #1a2e1a;
  color: #ffffff;
}

/* ===== GRID MENU ===== */

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

/* ===== KARTU MENU ===== */
.menu-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

/* Sembunyikan card yang tidak sesuai kategori */
.menu-card.hidden {
  display: none;
}

/* GAMBAR */
.menu-img-wrapper {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 8px;
}

.menu-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.menu-card:hover .menu-img-wrapper img {
  transform: scale(1.04);
}

/* INFO DI BAWAH GAMBAR */
.menu-info {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.menu-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.menu-title-row h3 {
  font-family: 'DynaPuff', system-ui;
  font-size: 15px;
  font-weight: 700;
  color: #1a2e1a;
  line-height: 1.4;
}

.menu-price {
  font-family: 'Raleway', sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: #1a2e1a;
  white-space: nowrap;
}

.menu-desc {
  font-family: 'Raleway', sans-serif;
  font-size: 11px;
  font-weight: 400;
  color: #636262;
  line-height: 1,3;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .menu-section {
    padding: 60px 20px;
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .menu-header h2 {
    font-size: 36px;
  }

  .cat-btn {
    font-size: 12px;
    padding: 8px 20px;
  }
}
